{
  "name": "sanchivue-backend",
  "version": "1.0.0",
  "description": "Sanchivue — Live Technical Interview & AI Assessment Platform backend (pure-JS MERN + Socket.io).",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "vitest run"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.5",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "mongoose-aggregate-paginate-v2": "^1.1.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "socket.io": "^4.8.4",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
